{
  "version": "ver 0.12",
  "window_width": 760,
  "window_height": 640,
  "refresh_interval_ms": 300000,
  "auto_load_delay_ms": 10,
  "min_fetch_interval": 60,
  "retry_count": 2,
  "retry_delay": 1.0,
  "cdp_port": 9222,
  "history_limit": 200,
  "esentutl_timeout": 30,
  "cdp_login_wait_seconds": 180,
  "cdp_poll_interval": 5,
  "cdp_fetch_timeout": 10,
  "cdp_wait_timeout": 30,
  "http_timeout": 15,
  "subprocess_timeout": 10,
  "table_limit_group": 50,
  "table_limit_day": 200,
  "app_name": "myboard",
  "log_level": "INFO",
  "db_default_path": "~/.local/share/opencode/opencode.db",
  "export_limit": 100000,
  "price_cache_ttl": 86400,
  "models_dev_url": "https://models.dev/api.json",
  "user_config_path": "config/user_config.json",
  "credentials_dir": "data/credentials",
  "logs_dir": "data/logs",
  "prices_dir": "data/prices",
  "default_theme": "light"
}
